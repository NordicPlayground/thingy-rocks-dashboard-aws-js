{
  "name": "@nordicsemiconductor/thingy-rocks-dashboard",
  "version": "0.0.0-development",
  "description": "thingy.rocks AWS IoT dashboard developed using Preact in TypeScript",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NordicPlayground/thingy-rocks-dashboard-aws-js.git"
  },
  "keywords": [
    "thingy-world",
    "iot",
    "aws",
    "demo",
    "preact"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/NordicPlayground/thingy-rocks-dashboard-aws-js/issues"
  },
  "homepage": "https://github.com/NordicPlayground/thingy-rocks-dashboard-aws-js#readme",
  "scripts": {
    "start": "vite",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --emptyOutDir",
    "prepare": "husky",
    "postinstall": "cp -r node_modules/svg-country-flags/svg/ static/flags",
    "test": "find ./ -type f -name '*.spec.ts' -not -path './node_modules/*' -print | xargs node --experimental-strip-types --no-warnings --test"
  },
  "dependencies": {
    "@aws-amplify/core": "6.12.0",
    "@aws-sdk/credential-provider-cognito-identity": "3.823.0",
    "@aws/amazon-location-utilities-auth-helper": "1.2.2",
    "@bifravst/rsrp-bar": "8.0.7",
    "@hello.nrfcloud.com/proto-map": "16.3.25",
    "@sentry/react": "9.25.1",
    "@sentry/tracing": "7.120.3",
    "@sentry/vite-plugin": "3.5.0",
    "compare-versions": "6.1.1",
    "date-fns": "4.1.0",
    "e118-iin-list": "4.5.0",
    "lodash-es": "4.17.21",
    "lucide-preact": "0.513.0",
    "maplibre-gl": "5.6.0",
    "preact": "10.26.8",
    "preact-router": "4.1.2",
    "styled-components": "6.1.18",
    "svg-country-flags": "1.2.10"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "6.3.0",
    "@bifravst/prettier-config": "1.1.8",
    "@commitlint/config-conventional": "19.8.1",
    "@nordicsemiconductor/from-env": "3.0.1",
    "@preact/preset-vite": "2.10.1",
    "@swc/core": "1.11.29",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.15.29",
    "@types/semver": "7.7.0",
    "bootstrap": "5.3.6",
    "chalk": "5.4.1",
    "commitlint": "19.8.1",
    "handlebars": "4.7.8",
    "husky": "9.1.7",
    "id128": "1.6.6",
    "lint-staged": "16.1.0",
    "prettier-plugin-organize-imports": "4.1.0",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
